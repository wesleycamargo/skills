{
  "name": "@wesleycamargo/skills-sync",
  "version": "0.1.4",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wesleycamargo/skills.git"
  },
  "bin": {
    "skills-sync": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test:publish-npm": "bash scripts/publish-npm.test.sh",
    "test": "npm run test:publish-npm && npm run build && node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test dist-test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "skills": "1.7.0"
  },
  "license": "GPL-3.0-or-later"
}
